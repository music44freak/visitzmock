<?xml version="1.0" encoding="utf-8" ?>
<baseClasses:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:baseClasses="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:familyMembers="clr-namespace:Visitz.Views.Entity.FamilyMembers"
    x:Class="Visitz.Views.Entity.FamilyMembers.EntityContactsView"
    x:DataType="familyMembers:EntityContactsViewModel"
    x:TypeArguments="familyMembers:EntityContactsViewModel"
>
    <AbsoluteLayout>
        <controls:EmptyIcon
            AbsoluteLayout.LayoutFlags="PositionProportional"
            AbsoluteLayout.LayoutBounds="0.5,0.5"
            IsVisible="{Binding IsEmpty}"
        />

        <CollectionView
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            ItemsSource="{Binding ContactViewModels}"
            SelectionMode="None"
        >
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="familyMembers:ContactItemViewModel">
                    <familyMembers:ContactItemView />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </AbsoluteLayout>
</baseClasses:IcmRecordContentView>
