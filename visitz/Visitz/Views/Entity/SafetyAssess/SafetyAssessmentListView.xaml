<?xml version="1.0" encoding="utf-8" ?>
<base:IcmRecordContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:Visitz.Views.BaseClasses"
    xmlns:controls="clr-namespace:Visitz.Controls"
    xmlns:converters="clr-namespace:Visitz.Converters"
    xmlns:icons="clr-namespace:Visitz.FontIcons"
    xmlns:local="clr-namespace:Visitz.Localization"
    xmlns:safety="clr-namespace:Visitz.Views.Entity.SafetyAssess"
    xmlns:safetyModels="clr-namespace:VisitzModel.Models.SafetyAssess;assembly=VisitzModel"
    x:Class="Visitz.Views.Entity.SafetyAssess.SafetyAssessmentListView"
    x:DataType="safety:SafetyAssessmentListViewModel"
    x:TypeArguments="safety:SafetyAssessmentListViewModel"
>
    <base:IcmRecordContentView.Resources>
        <converters:DateTimeOffsetShortTimestampConverter x:Key="ShortTimestampConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </base:IcmRecordContentView.Resources>

    <Grid RowDefinitions="*,0.5,Auto">
        <VerticalStackLayout IsVisible="{Binding IsEmpty, Converter={StaticResource BoolNegationConverter}}">
            <Grid ColumnDefinitions="*,*,*,*" Padding="{StaticResource DefaultPadding}">
                <Label
                    Grid.Column="0"
                    FontFamily="BCSansBold"
                    Text="{local:Localize CreatedDate}"
                />

                <Label Grid.Column="1" FontFamily="BCSansBold" Text="{local:Localize CreatedBy}" />

                <Label
                    Grid.Column="2"
                    FontFamily="BCSansBold"
                    Text="{local:Localize ApprovedDate}"
                />

                <Label Grid.Column="3" FontFamily="BCSansBold" Text="{local:Localize ApprovedBy}" />
            </Grid>

            <BoxView HeightRequest="0.5" Color="{StaticResource SeparatorColor}" />

            <CollectionView Grid.Row="0" ItemsSource="{Binding Assessments}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="safetyModels:SafetyAssessment">
                        <ContentView>
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenSafetyAssessmentViewCommand,
                                        Source={RelativeSource
                                            AncestorType={x:Type safety:SafetyAssessmentListViewModel}}}"
                                    CommandParameter="{Binding .}"
                                />
                            </ContentView.GestureRecognizers>

                            <VerticalStackLayout>
                                <Grid
                                    ColumnDefinitions="*,*,*,*"
                                    Padding="{StaticResource DefaultPadding}"
                                >
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding CreatedDate, Converter={StaticResource ShortTimestampConverter}}"
                                    />

                                    <Label Grid.Column="1" Text="{Binding CreatedBy}" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding ApprovedDate, Converter={StaticResource ShortTimestampConverter}}"
                                    />

                                    <Label Grid.Column="3" Text="{Binding ApprovedBy}" />
                                </Grid>

                                <BoxView
                                    HeightRequest="0.5"
                                    Color="{StaticResource SeparatorColor}"
                                    Margin="{Thickness
                                        Left={StaticResource DefaultMargin},
                                        Right={StaticResource DefaultMargin}}"
                                />
                            </VerticalStackLayout>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <controls:EmptyIcon IsVisible="{Binding IsEmpty}" />

        <BoxView Grid.Row="1" Color="{StaticResource SeparatorColor}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="10">
            <Button
                Grid.Column="2"
                Text="{Binding EditViewButtonText, TargetNullValue={local:Localize AddNew}}"
                Command="{Binding OpenSafetyAssessmentViewCommand}"
            >
                <Button.ImageSource>
                    <FontImageSource
                        Glyph="{Binding EditViewButtonGlyph, TargetNullValue={Static icons:MaterialIcons.Assignment_add}}"
                        FontFamily="MaterialIconsRoundedUnfilled"
                        Size="20"
                    />
                </Button.ImageSource>
            </Button>
        </Grid>
    </Grid>
</base:IcmRecordContentView>
